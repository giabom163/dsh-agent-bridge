{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "协同桥任务契约",
  "type": "object",
  "required": ["task_id", "goal", "repo", "executor", "allowed_paths", "artifacts", "completion_criteria"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 100},
    "opencode_mode": {"enum": ["shared", "standalone"], "description": "新前端默认 shared；旧契约缺省 standalone。先 prepare 再确认可见并 run。"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "goal": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1, "description": "已提交且工作区干净的 Git 仓库根目录绝对路径"},
    "executor": {"enum": ["dsh", "opencode"]},
    "model": {"type": "string", "description": "仅 OpenCode，必须明确 provider/model；DSH 不支持命令行覆盖"},
    "agent": {"type": "string", "description": "OpenCode 的已有 Agent；桥不创建子代理"},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "anchors": {"type": "array", "items": {"type": "string", "minLength": 1,
      "description": "可选。形如 web/task-graph.js:147,184,251-253：repo 相对路径 + 正整数行或正序起-止区间（逗号分隔）。文件必须列入 input_refs 以固定 hash；越界、反向区间与非正整数由 bridge.py 拒绝。旧契约无此字段继续兼容。"}},
    "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}},
    "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 3600, "default": 300}
  },
  "description": "实际校验由 bridge.py 执行，还检查相对路径、输入哈希、依赖和 Git 基线。"
}
